{
  "name": "axiom-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "arch": "bun run --filter @axiom/backend arch",
    "secrets": "secretlint \"**/*\"",
    "verify": "bun run lint && bun run typecheck && bun run arch && bun run test && bun run secrets",
    "test:integration": "bun run --filter @axiom/backend test:integration",
    "test:e2e": "bun scripts/test-e2e.ts",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "prepare": "lefthook install"
  },
  "overrides": {
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "lefthook": "^2.2.2",
    "secretlint": "^13.0.7",
    "typescript": "^6.0.3"
  }
}
