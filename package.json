{
  "name": "axiom-crm",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "arch": "bun run --filter @axiom/backend arch",
    "secrets": "secretlint \"**/*\"",
    "verify": "bun run lint && bun run typecheck && bun run arch && bun run test && bun run secrets",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "lefthook": "^2.2.2",
    "secretlint": "^13.0.7",
    "typescript": "^6.0.3"
  }
}
