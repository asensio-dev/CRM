# Copia este archivo a backend/.env (ignorado por git) y rellena los valores.
# Aquí solo van NOMBRES de variables y valores de ejemplo NO sensibles.

# Conexión SQL Server (formato Prisma). La contraseña NUNCA se escribe en este archivo.
# sqlserver://HOST:PUERTO;database=AxiomCRM;user=<USUARIO>;password=<CONTRASEÑA>;encrypt=true;trustServerCertificate=true
DATABASE_URL=
# Base sombra que usa `prisma migrate dev` (solo desarrollo)
SHADOW_DATABASE_URL=

# JWT (generar con: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173
TZ=America/Managua

# Usuario administrador inicial que crea el seed (la contraseña se pide por variable, nunca en código)
SEED_ADMIN_EMAIL=admin@axiom.local
SEED_ADMIN_PASSWORD=
